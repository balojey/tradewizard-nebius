{
  "name": "tradewizard-infra",
  "version": "1.0.0",
  "description": "TradeWizard V2 AWS CDK Infrastructure",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest --run",
    "test:watch": "vitest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "synth:dev": "cdk synth -c env=development",
    "synth:prod": "cdk synth -c env=production",
    "deploy:dev": "./deploy.sh up dev",
    "deploy:prod": "./deploy.sh up prod",
    "deploy:dev:fast": "./deploy.sh up dev --skip-db",
    "deploy:prod:fast": "./deploy.sh up prod --skip-db",
    "destroy:dev": "./deploy.sh down dev",
    "destroy:prod": "./deploy.sh down prod",
    "status:dev": "./deploy.sh status dev",
    "status:prod": "./deploy.sh status prod",
    "diff:dev": "cdk diff --all -c env=development",
    "diff:prod": "cdk diff --all -c env=production",
    "wipe:dev": "./wipe-data.sh dev",
    "wipe:prod": "./wipe-data.sh prod"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.985.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1048.0",
    "@aws-sdk/client-dynamodb": "^3.985.0",
    "@aws-sdk/client-eventbridge": "^3.985.0",
    "@aws-sdk/client-lambda": "^3.1060.0",
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/client-scheduler": "^3.985.0",
    "@aws-sdk/client-secrets-manager": "^3.985.0",
    "@aws-sdk/client-sesv2": "^3.985.0",
    "@aws-sdk/client-sns": "^3.1047.0",
    "@aws-sdk/client-sqs": "^3.985.0",
    "@aws-sdk/util-dynamodb": "^3.985.0",
    "@strands-agents/sdk": "^1.4.0",
    "aws-cdk-lib": "^2.178.2",
    "constructs": "^10.4.2",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.49.0",
    "pg": "^8.20.0",
    "source-map-support": "^0.5.21",
    "viem": "^2.50.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.20.0",
    "aws-cdk": "^2.178.2",
    "esbuild": "^0.25.4",
    "fast-check": "^4.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
