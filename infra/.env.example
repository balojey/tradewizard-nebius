# ============================================================================
# TradeWizard V2 Infrastructure - Environment Variables
#
# Copy this file to create environment-specific configs:
#   cp .env.example .env.dev    # Development environment
#   cp .env.example .env.prod   # Production environment
#
# The deploy.sh script automatically loads .env.{dev|prod} based on the
# target environment. Variables defined here are used by CDK stacks and
# the deploy script for secret creation and configuration.
# ============================================================================

# ─── AWS Configuration ────────────────────────────────────────────────────────

# AWS region for all resources (default: us-east-1)
AWS_REGION=us-east-1

# AWS account ID (auto-detected if not set)
# CDK_DEFAULT_ACCOUNT=123456789012

# ─── AI Provider (Nebius Token Factory) ──────────────────────────────────────
# All analysis and portfolio model calls run on Nebius Token Factory's
# OpenAI-compatible API. This covers inference only; orchestration,
# persistence, and trade execution remain deterministic application code on
# the deployment substrate.
AI_PROVIDER=nebius

# Nebius API key, stored in Secrets Manager as tw-{env}-nebius-api-key
# by deploy.sh. Leave blank here and populate .env.dev / .env.prod.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MAX_TOKENS=30000

# Capability -> model ID mapping. Every capability except NON_TOOL must
# support OpenAI-style function/tool calling. These IDs were validated against
# the live catalog; re-run the validator after Nebius catalog changes:
#   set -a; source .env.dev; set +a; npx tsx scripts/validate-nebius.ts
#
# NVIDIA Nemotron 3 Super is the agentic bucket: news/event agents and the
# web-research stage, where tool calling and multi-step retrieval matter most.
NEBIUS_MODEL_FAST=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_MODEL_ANALYTICAL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_MODEL_AGENTIC=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_REASONING=openai/gpt-oss-120b
NEBIUS_MODEL_DEEP_REASONING=deepseek-ai/DeepSeek-V4-Pro
NEBIUS_MODEL_NON_TOOL=moonshotai/Kimi-K3
NEBIUS_MODEL_DEFAULT=MiniMaxAI/MiniMax-M3

# Optional per-capability max-token overrides (fall back to NEBIUS_MAX_TOKENS):
# NEBIUS_MODEL_FAST_MAX_TOKENS=
# NEBIUS_MODEL_ANALYTICAL_MAX_TOKENS=
# NEBIUS_MODEL_AGENTIC_MAX_TOKENS=
# NEBIUS_MODEL_REASONING_MAX_TOKENS=
# NEBIUS_MODEL_DEEP_REASONING_MAX_TOKENS=
# NEBIUS_MODEL_NON_TOOL_MAX_TOKENS=
# NEBIUS_MODEL_DEFAULT_MAX_TOKENS=

# ─── Wallet Payment Configuration (Polygon / USDC.e) ─────────────────────────

# Platform Wallet address - receives all USDC.e subscription and credit pack payments
# This is the PUBLIC address, not the private key.
PLATFORM_WALLET_ADDRESS=0x...

# Platform Wallet private key - used ONLY by the Renewal Lambda for transferFrom
# This key allows automatic subscription renewals via ERC-20 allowance.
# Stored in AWS Secrets Manager (tw-{env}-platform-wallet-key).
# If set here, deploy.sh will create/update the secret automatically.
# If not set, deploy.sh will prompt interactively on first deploy.
PLATFORM_WALLET_PRIVATE_KEY=

# USDC.e contract address on Polygon (default: bridged USDC on Polygon PoS)
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# Polygon JSON-RPC endpoint (use a dedicated provider for production)
# Free options: https://polygon-rpc.com, https://rpc.ankr.com/polygon
# Paid (recommended for prod): Alchemy, Infura, QuickNode
POLYGON_RPC_URL=https://polygon-rpc.com

# Safe (Gnosis Safe) factory address for deterministic wallet derivation
# Used to derive Trading Wallet addresses from EOA addresses
SAFE_FACTORY_ADDRESS=0x...

# ─── Magic SDK (Wallet Authentication) ───────────────────────────────────────

# Magic SDK secret key for wallet-based authentication
# Stored in AWS Secrets Manager (tw-{env}-magic-secret-key).
# If set here, deploy.sh will create/update the secret automatically.
# If not set, deploy.sh will prompt interactively on first deploy.
MAGIC_SECRET_KEY=

# Magic SDK publishable key (public, safe to embed in frontend)
# Used by the Amplify frontend build for NEXT_PUBLIC_MAGIC_API_KEY
MAGIC_PUBLISHABLE_KEY=

# ─── Polymarket Builder Credentials (Server-Side Signing) ─────────────────────

# Builder API credentials used by the Next.js /api/polymarket/sign route
# for relay client authentication (transaction signing, order attribution).
# These are server-side secrets - NOT prefixed with NEXT_PUBLIC_.
# Obtain from: https://polymarket.com/settings?tab=builder
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Optional builder code (bytes32 hex) used to attribute Polymarket Bridge
# traffic to TradeWizard. Get it from polymarket.com/settings?tab=builder and
# set it in the frontend/Amplify environment (server-side, not NEXT_PUBLIC_).
POLYMARKET_BUILDER_CODE=

# ─── Email Delivery (Resend primary, SES retained) ──────────────────────────

# Active transactional email provider: "resend" (default) or "ses".
# There is no automatic fallback; switch explicitly to "ses" only if needed.
EMAIL_PROVIDER=resend

# Resend API key. deploy.sh stores this in Secrets Manager as
# tw-{env}-resend-api-key; the raw key is NOT injected into Lambda env vars.
# Obtain one at https://resend.com/api-keys (sending access is sufficient).
# Leave blank locally and populate .env.dev / .env.prod instead.
RESEND_API_KEY=

# Sender address for Resend emails. The domain (tradewizard.live) must be
# verified in the Resend dashboard with the required DNS records.
# Use onboarding@resend.dev for limited testing (only delivers to the
# Resend account owner's email address).
RESEND_FROM_EMAIL=notifications@tradewizard.live

# Optional Reply-To address for Resend emails.
# RESEND_REPLY_TO=support@tradewizard.live

# SES is retained for future use and as an explicit fallback
# (EMAIL_PROVIDER=ses, subject to SES sandbox restrictions).
SES_FROM_EMAIL=notifications@tradewizard.live

# Application URL used in email links and notifications (default: http://localhost:3000 for dev, https://tradewizard.live for prod)
APP_URL=http://localhost:3000

# ─── Polymarket CLOB API (Portfolio Manager) ─────────────────────────────────

# Polymarket CLOB API credentials for autonomous order placement
# Required for the Portfolio Manager to place/cancel orders on behalf of users
CLOB_API_URL=https://clob.polymarket.com
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# ─── Analysis Lambda (Intelligence Agents) ───────────────────────────────────

# NewsData.io API key(s) for news-focused intelligence agents
# Supports comma-separated keys for rotation on rate limit (HTTP 429)
NEWSDATA_API_KEY=

# Serper API key(s) for web search/scrape intelligence agents
# Supports comma-separated keys for rotation on rate limit (HTTP 429)
SERPER_API_KEY=

# Number of past analyses to fetch for agent memory (default: 5, range: 1-20)
ANALYSIS_HISTORY_DEPTH=5

# Max tool calls per agent per analysis (prevents runaway tool loops)
# NEWS_TOOL_MAX_CALLS: max news_search calls per agent (default: 5)
# SHELL_TOOL_MAX_CALLS: max shell_analysis calls per agent (default: 15)
NEWS_TOOL_MAX_CALLS=5
SHELL_TOOL_MAX_CALLS=15

# CDK environment context (auto-set by deploy.sh, rarely needed manually)
# ENVIRONMENT=development

# Skip specific deploy steps (can also use --skip-db flag)
# SKIP_DB=false

STALE_THRESHOLD_MINUTES=

# ─── Lambda Configuration ─────────────────────────────────────────────────────

# Timeout for all Lambda functions in seconds (default: 600 = 10 minutes)
LAMBDA_TIMEOUT_SECONDS=600